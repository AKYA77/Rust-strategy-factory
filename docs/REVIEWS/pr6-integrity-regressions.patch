+    #[test]
+    fn codex_review_partial_resume_must_reject_self_hashed_different_prices() {
+        let (dir, parquet, output, _) = fixture(migration_profile("NZDUSD"), 7);
+        let config = Config::new(&parquet, &output, migration_profile("NZDUSD")).unwrap().with_chunk_events(7).unwrap().with_manifest(&dir.join("manifest.json")).unwrap();
+        let initial = convert(&config).unwrap();
+        fs::remove_file(output.join("manifest.json")).unwrap();
+        let path = output.join(&initial.chunks[0].file);
+        let original = native::read(&path).unwrap();
+        let mut ticks = original.ticks.clone();
+        for tick in &mut ticks { tick.bid += original.profile.tick; tick.ask += original.profile.tick; }
+        let mut changed = data::dataset(original.profile.clone(), ticks, &original.manifest.source, original.manifest.archive_hash.clone(), false).unwrap();
+        changed.manifest.parser_version = original.manifest.parser_version.clone();
+        changed.manifest.imported_at = original.manifest.imported_at.clone();
+        fs::remove_file(&path).unwrap(); native::write(&path, &changed).unwrap();
+        assert!(convert(&config).is_err(), "resume accepted different native prices bound only by self-computed hashes");
+        fs::remove_dir_all(dir).unwrap();
+    }
