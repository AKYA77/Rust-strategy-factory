+    #[test]
+    fn codex_review_completed_conversion_must_bind_requested_profile_and_source() {
+        let (dir, parquet, output, _) = fixture(migration_profile("NZDUSD"), 7);
+        let config = Config::new(&parquet, &output, migration_profile("NZDUSD")).unwrap().with_chunk_events(7).unwrap().with_manifest(&dir.join("manifest.json")).unwrap();
+        convert(&config).unwrap();
+        let changed = Config::new(&dir.join("missing-different-source.parquet"), &output, migration_profile("EURUSD")).unwrap();
